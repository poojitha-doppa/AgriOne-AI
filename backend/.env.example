PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>
JWT_SECRET=your_jwt_secret_here

# Admin login credentials (required for admin access)
ADMIN_PHONE=
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:8080

# Roboflow workflow mode
ROBOFLOW_API_KEY=
# Example: https://detect.roboflow.com/workflows/<workspace>/<workflow-id>
# Make sure this URL points to an active workflow endpoint that accepts base64 image input.
ROBOFLOW_URL=
ROBOFLOW_CONFIDENCE_CONFIRMED=65
ROBOFLOW_CONFIDENCE_LOW=35

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# LLM provider config: auto | openrouter | gemini
LLM_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Agri_Mytra

NEWS_API_KEY=your_news_api_key